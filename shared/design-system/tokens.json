{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "name": "DiskWarren Design System Tokens",
  "version": "1.0.0",
  "platforms": ["macos", "windows", "android", "ios"],
  "colors": {
    "brand": {
      "cyan50": "#ECFEFF",
      "cyan100": "#CFFAFE",
      "cyan500": "#06B6D4",
      "cyan600": "#0891B2",
      "cyan700": "#0E7490",
      "blue600": "#2563EB",
      "blue700": "#1D4ED8"
    },
    "semantic": {
      "safeLow": "#10B981",
      "safeLowBg": "#ECFDF5",
      "reviewAmber": "#F59E0B",
      "reviewAmberBg": "#FFFBEB",
      "restrictedRed": "#EF4444",
      "restrictedRedBg": "#FEF2F2",
      "systemSlate": "#64748B",
      "systemSlateBg": "#F1F5F9"
    },
    "surface": {
      "backgroundLight": "#F8FAFC",
      "cardLight": "#FFFFFF",
      "borderLight": "#E2E8F0",
      "textPrimaryLight": "#0F172A",
      "textSecondaryLight": "#64748B",
      "backgroundDark": "#090D16",
      "cardDark": "#111827",
      "borderDark": "#1F2937",
      "textPrimaryDark": "#F9FAFB",
      "textSecondaryDark": "#9CA3AF"
    }
  },
  "typography": {
    "macOS": "-apple-system, BlinkMacSystemFont, 'SF Pro Display', 'SF Pro Text'",
    "windows": "'Segoe UI Variable', 'Segoe UI', -apple-system, sans-serif",
    "android": "'Roboto Flex', 'Roboto', sans-serif",
    "iOS": "'SF Pro', -apple-system, BlinkMacSystemFont, sans-serif"
  },
  "safetyCategories": {
    "low": {
      "label": "Low Risk",
      "description": "Caches, temporary build files, disposable indexes. Safe to recycle.",
      "reversible": true,
      "defaultSelected": true
    },
    "review": {
      "label": "Review Needed",
      "description": "User projects, local AI weights, unlinked modules. Requires explicit review.",
      "reversible": true,
      "defaultSelected": false
    },
    "restricted": {
      "label": "Restricted",
      "description": "Operating system files, system registries, keychains, active databases. Write-blocked.",
      "reversible": false,
      "defaultSelected": false
    }
  }
}
