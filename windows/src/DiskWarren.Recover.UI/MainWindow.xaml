<Window x:Class="DiskWarren.Recover.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        mc:Ignorable="d"
        Title="DiskWarren Recover — Safe, Read-Only Data Recovery for Windows"
        Height="840" Width="1280"
        MinHeight="680" MinWidth="980"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        Icon="pack://application:,,,/app.ico"
        Background="#0B0F19">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="42" ResizeBorderThickness="6" CornerRadius="8" GlassFrameThickness="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>
    <Border x:Name="WindowBorder" BorderThickness="0" BorderBrush="#334155" CornerRadius="0" SnapsToDevicePixels="True" Background="#0B0F19">
        <Grid Background="#0B0F19">
            <Grid.RowDefinitions>
                <RowDefinition Height="42" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Native Top Titlebar (Unified & Always accessible so window can be dragged, minimized, maximized, and closed) -->
            <Border Grid.Row="0" Background="#111827" BorderThickness="0,0,0,1" BorderBrush="#1F2937">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- App Title, Badges & Shield -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                        <Image Source="pack://application:,,,/app.ico" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,10,0" RenderOptions.BitmapScalingMode="HighQuality" />
                        <TextBlock Text="DiskWarren Recover" FontWeight="Bold" FontSize="13" Foreground="#F8FAFC" VerticalAlignment="Center" />
                        <Border Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtEditionBadge" Text="Community Edition" FontSize="10" FontWeight="SemiBold" Foreground="#94A3B8" />
                        </Border>
                        <Border Background="#132B2B" BorderBrush="#0D9488" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="8,0,0,0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="6" Height="6" Fill="#10B981" Margin="0,0,5,0" VerticalAlignment="Center" />
                                <TextBlock Text="Read-Only Source Lock" FontSize="10" FontWeight="SemiBold" Foreground="#2DD4BF" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Drag Surface (Native caption handled by WindowChrome) -->
                    <Border Grid.Column="1" Background="Transparent" />

                    <!-- Native Window Control Buttons (Must have IsHitTestVisibleInChrome="True") -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,6,0" WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button x:Name="BtnLicense" Click="BtnLicense_Click" WindowChrome.IsHitTestVisibleInChrome="True"
                                Margin="0,0,8,0" Cursor="Hand" ToolTip="Licensing &amp; Activation">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" BorderBrush="#334155" BorderThickness="1" CornerRadius="6" Padding="10,4">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Setter Property="Background" Value="#1E293B" />
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#334155" />
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter Property="Background" Value="#0F172A" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <TextBlock Text="★ License" FontSize="11" FontWeight="SemiBold" Foreground="#F59E0B" VerticalAlignment="Center" />
                        </Button>

                        <Rectangle Width="1" Height="16" Fill="#1F2937" Margin="0,0,6,0" VerticalAlignment="Center" />

                        <Button x:Name="BtnMinimize" Click="BtnMinimize_Click" Width="40" Height="30" Margin="1,0" WindowChrome.IsHitTestVisibleInChrome="True" Cursor="Hand" ToolTip="Minimize">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="Foreground" Value="#94A3B8" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="4">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#1E293B" />
                                            <Setter Property="Foreground" Value="#FFFFFF" />
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter Property="Background" Value="#334155" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <TextBlock Text="&#x2014;" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center" />
                        </Button>

                        <Button x:Name="BtnMaximize" Click="BtnMaximize_Click" Width="40" Height="30" Margin="1,0" WindowChrome.IsHitTestVisibleInChrome="True" Cursor="Hand" ToolTip="Maximize / Restore Down">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="Foreground" Value="#94A3B8" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="4">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#1E293B" />
                                            <Setter Property="Foreground" Value="#FFFFFF" />
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter Property="Background" Value="#334155" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <TextBlock x:Name="TxtMaximizeIcon" Text="&#x29C9;" FontSize="13" VerticalAlignment="Center" HorizontalAlignment="Center" />
                        </Button>

                        <Button x:Name="BtnClose" Click="BtnClose_Click" Width="40" Height="30" Margin="1,0" WindowChrome.IsHitTestVisibleInChrome="True" Cursor="Hand" ToolTip="Close">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="Foreground" Value="#94A3B8" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="4">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#EF4444" />
                                            <Setter Property="Foreground" Value="#FFFFFF" />
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter Property="Background" Value="#DC2626" />
                                            <Setter Property="Foreground" Value="#FFFFFF" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <TextBlock Text="&#x2715;" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Center" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Main Content Area with Fallback & Loading Stack -->
            <Grid Grid.Row="1">
                <!-- Layer 0: High-Performance WebView2 Browser Control -->
                <wv2:WebView2 x:Name="WebViewControl" DefaultBackgroundColor="#0B0F19" />

                <!-- Layer 1: Native Loading & Branding Splash (Guarantees window NEVER appears black) -->
                <Grid x:Name="LoadingOverlay" Background="#0B0F19" Panel.ZIndex="10" Visibility="Visible">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="440">
                        <Border Width="64" Height="64" CornerRadius="16" Background="#132B2B" BorderBrush="#0D9488" BorderThickness="1.5" HorizontalAlignment="Center" Margin="0,0,0,20">
                            <Image Source="pack://application:,,,/app.ico" Width="36" Height="36" HorizontalAlignment="Center" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />
                        </Border>
                        <TextBlock Text="DiskWarren Recover" FontSize="24" FontWeight="ExtraBold" Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,6" />
                        <TextBlock Text="Safe Read-Only Data Recovery &amp; Raw Carving Engine" FontSize="13" Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,0,0,24" />
                        
                        <ProgressBar x:Name="LoadingProgressBar" IsIndeterminate="True" Height="6" BorderThickness="0" Background="#1E293B" Foreground="#0D9488" Margin="0,0,0,14" />
                        <TextBlock x:Name="LoadingStatusText" Text="Initializing secure storage engine..." FontSize="12" Foreground="#64748B" HorizontalAlignment="Center" />
                    </StackPanel>
                </Grid>

                <!-- Layer 2: Native Error / Missing Runtime Fallback Card -->
                <Grid x:Name="ErrorOverlay" Background="#0B0F19" Panel.ZIndex="20" Visibility="Collapsed">
                    <Border Background="#111827" BorderBrush="#334155" BorderThickness="1" CornerRadius="12" Width="520" Padding="32" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20">
                        <StackPanel>
                            <Border Width="52" Height="52" CornerRadius="26" Background="#3B1818" BorderBrush="#EF4444" BorderThickness="1" HorizontalAlignment="Center" Margin="0,0,0,16">
                                <TextBlock Text="!" FontSize="26" FontWeight="Bold" Foreground="#EF4444" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="Modern UI Engine Setup Required" FontSize="18" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,8" />
                            <TextBlock Text="DiskWarren Recover requires the Microsoft Edge WebView2 Runtime to display its hardware recovery dashboard." FontSize="12" Foreground="#94A3B8" TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,16" LineHeight="18" />
                            
                            <Border Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,20">
                                <TextBlock x:Name="ErrorDetailsText" Text="Status details here..." FontSize="11" FontFamily="Consolas" Foreground="#CBD5E1" TextWrapping="Wrap" />
                            </Border>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button x:Name="BtnDownloadWebView2" Click="BtnDownloadWebView2_Click" Content="Download WebView2 Runtime" Background="#0D9488" Foreground="White" FontWeight="SemiBold" FontSize="12" Padding="16,10" BorderThickness="0" Cursor="Hand" Margin="0,0,10,0">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="6" />
                                        </Style>
                                    </Button.Resources>
                                </Button>
                                <Button x:Name="BtnRetryInit" Click="BtnRetryInit_Click" Content="Retry Initialization" Background="#334155" Foreground="White" FontWeight="SemiBold" FontSize="12" Padding="16,10" BorderThickness="0" Cursor="Hand">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="6" />
                                        </Style>
                                    </Button.Resources>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>